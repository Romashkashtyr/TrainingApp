<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:name=".presentation.TrainingApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrainingApp"
        tools:targetApi="31" >
        <activity
            android:name="com.example.splash.ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TrainingApp" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.trainings.TrainingsListActivity"
            android:exported="false" />
        <activity
            android:name="com.example.auth.ui.AuthorizationActivity"
            android:exported="false"
            android:theme="@style/Theme.TrainingApp" >
        </activity>
        <activity
            android:name="com.example.main.ui.MainActivity"
            android:exported="false" >
        </activity>
    </application>

</manifest>